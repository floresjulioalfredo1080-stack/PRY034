# Base de datos
DATABASE_URL="file:./dev.db"

# Autenticación
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-en-produccion"

# Email (opcional — si faltan, las notificaciones se simulan en consola)
EMAIL_USER=""
EMAIL_PASS=""

# ============ IZIPAY (pasarela de pago) ============
# IZIPAY_SIMULATE=false activa las llamadas reales en backend/izipay.js.
# Mientras no haya credenciales, déjalo en true (o sin definir) para seguir
# usando la simulación. Ver README.md → "Pasarela de pago (IZIPAY)".
IZIPAY_SIMULATE="true"
IZIPAY_MERCHANT_CODE=""
IZIPAY_PUBLIC_KEY=""
IZIPAY_PRIVATE_KEY=""
IZIPAY_MODE="sandbox"
